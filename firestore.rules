rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/adminEmails/$(request.auth.token.email)).data.active == true;
    }

    match /adminEmails/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /userProfiles/{uid} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'firstName',
          'lastName',
          'dni',
          'phone',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.dni is string
        && request.resource.data.phone is string;
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isAdmin() || (
        isSignedIn()
        && resource.data.createdByUid == request.auth.uid
      );
      allow list: if isAdmin() || (
        isSignedIn()
        && resource.data.createdByUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'code',
          'items',
          'status',
          'customerName',
          'customerEmail',
          'createdByUid',
          'paymentAlias',
          'pickupOption',
          'projectName',
          'note',
          'reserveDeposit',
          'guaranteeAmount',
          'rentalTotal',
          'totalEstimated',
          'holdExpiresAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'code',
          'items',
          'status',
          'customerName',
          'customerEmail',
          'createdByUid',
          'paymentAlias',
          'pickupOption',
          'reserveDeposit',
          'guaranteeAmount',
          'rentalTotal',
          'totalEstimated',
          'holdExpiresAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.code is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.status == 'payment_pending'
        && request.resource.data.customerName is string
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.paymentAlias == 'tomiboe'
        && request.resource.data.pickupOption in ['reservation_day', 'previous_day_requested']
        && request.resource.data.reserveDeposit is number
        && request.resource.data.guaranteeAmount is number
        && request.resource.data.rentalTotal is number
        && request.resource.data.totalEstimated is number
        && request.resource.data.holdExpiresAt is string
      );
      allow update, delete: if isAdmin();
    }

    match /reservationRanges/{rangeId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'productId',
          'quantity',
          'startDate',
          'endDate',
          'status',
          'holdExpiresAt',
          'createdAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.productId is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.status == 'payment_pending'
        && request.resource.data.holdExpiresAt is string
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.createdByUid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Reservas de versiones anteriores: sólo quedan visibles para su dueño y el equipo.
    match /reservations/{reservationId} {
      allow get: if isAdmin() || (
        isSignedIn()
        && (
          resource.data.createdByUid == request.auth.uid
          || resource.data.customerEmail == request.auth.token.email
        )
      );
      allow list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }
  }
}
