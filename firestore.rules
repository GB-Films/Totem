rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/adminEmails/$(request.auth.token.email)).data.active == true;
    }

    match /adminEmails/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
