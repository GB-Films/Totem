rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/adminEmails/$(request.auth.token.email)).data.active == true;
    }

    match /adminEmails/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /userProfiles/{uid} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'firstName',
          'lastName',
          'dni',
          'phone',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.dni is string
        && request.resource.data.phone is string;
      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'productId',
          'quantity',
          'rentalDays',
          'startDate',
          'endDate',
          'note',
          'status',
          'customerName',
          'customerEmail',
          'createdByUid',
          'paymentAlias',
          'pickupOption',
          'reserveDeposit',
          'guaranteeAmount',
          'totalEstimated',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll(['productId', 'startDate', 'endDate', 'status', 'createdByUid', 'createdAt'])
        && request.resource.data.productId is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.status in ['request_sent', 'payment_pending', 'confirmed']
        && request.resource.data.createdByUid == request.auth.uid
        && (!('customerEmail' in request.resource.data) || request.resource.data.customerEmail == request.auth.token.email)
        && (!('paymentAlias' in request.resource.data) || request.resource.data.paymentAlias == 'tomiboe')
        && (!('pickupOption' in request.resource.data) || request.resource.data.pickupOption in ['reservation_day', 'previous_day_requested'])
      );
      allow update, delete: if isAdmin();
    }
  }
}
